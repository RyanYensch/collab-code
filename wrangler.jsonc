{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "yensch-code",
    "main": "./worker/index.ts",
    "compatibility_date": "2026-08-30",
    "assets": {
        "not_found_handling": "single-page-application",
        "run_worker_first": [
            "/api/*",
            "/ws/*"
        ]
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "ROOMS",
                "class_name": "Room"
            }
        ]
    },

    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "Room"
            ]
        }
    ]
}